  "texts": [
    {
      "id": "de_morgen",
      "title": "Morgenroutine",
      "text": "Am {Morgen} trinke ich Kaffee und esse Brot mit Käse. Danach gehe ich zur {Arbeit} und lese meine Nachrichten.",
      "translation": "In the morning I drink coffee and eat bread with cheese. Then I go to work and read my messages.",
      "translationLanguage": "English"
    },
    {
      "id": "de_cafe",
      "title": "Im Café",
      "text": "Im Café bestelle ich einen {Kaffee} und ein kleines Stück Kuchen. Meine Freundin kommt später und wir {sprechen} über das Wochenende.",
      "translation": "In the café I order a coffee and a small piece of cake. My friend comes later and we talk about the weekend.",
      "translationLanguage": "English"
    },
    {
      "id": "de_zug",
      "title": "Mit dem Zug",
      "text": "Der {Zug} fährt um acht Uhr vom Bahnhof ab. Ich kaufe eine Karte und suche einen Platz am {Fenster}.",
      "translation": "The train leaves the station at eight. I buy a ticket and look for a seat by the window.",
      "translationLanguage": "English"
    },
    {
      "id": "de_arbeit",
      "title": "Bei der Arbeit",
      "text": "Bei der {Arbeit} habe ich zwei kurze Besprechungen. Danach schreibe ich einen Bericht und beantworte wichtige {Fragen}.",
      "translation": "At work I have two short meetings. Then I write a report and answer important questions.",
      "translationLanguage": "English"
    },
    {
      "id": "de_wohnung",
      "title": "Die Wohnung",
      "text": "Meine {Wohnung} ist klein, aber hell. Die Küche ist neben dem Zimmer, und der Tisch steht am {Fenster}.",
      "translation": "My apartment is small but bright. The kitchen is next to the room, and the table is by the window.",
      "translationLanguage": "English"
    },
    {
      "id": "de_wochenende",
      "title": "Wochenende",
      "text": "Am Wochenende wollen wir in die {Stadt} fahren. Wenn das Wetter gut ist, besuchen wir den Markt und essen draußen.",
      "translation": "On the weekend we want to go to the city. If the weather is good, we visit the market and eat outside.",
      "translationLanguage": "English"
    },
    {
      "id": "de_supermarkt",
      "title": "Im Supermarkt",
      "text": "Im Supermarkt kaufe ich Wasser, Äpfel und {Brot}. Der Preis ist gut, und die Verkäuferin ist sehr freundlich.",
      "translation": "In the supermarket I buy water, apples, and bread. The price is good, and the saleswoman is very friendly.",
      "translationLanguage": "English"
    },
    {
      "id": "de_besuch",
      "title": "Besuch",
      "text": "Heute besuche ich einen {Freund}. Er wohnt weit weg, deshalb fahre ich mit dem Bus und bringe etwas zu essen mit.",
      "translation": "Today I visit a friend. He lives far away, so I go by bus and bring something to eat.",
      "translationLanguage": "English"
    },
    {
      "id": "de_wetter",
      "title": "Wetter",
      "text": "Das {Wetter} ist heute kalt und windig. Trotzdem gehe ich zu Fuß, weil der Weg kurz ist und die Sonne scheint.",
      "translation": "The weather is cold and windy today. Still I walk, because the way is short and the sun is shining.",
      "translationLanguage": "English"
    },
    {
      "id": "de_reise",
      "title": "Reiseplanung",
      "text": "Für die {Reise} brauche ich einen Pass, eine Karte und eine Adresse. Morgen rufe ich das Hotel an.",
      "translation": "For the trip I need a passport, a ticket, and an address. Tomorrow I call the hotel.",
      "translationLanguage": "English"
    }
  ],
