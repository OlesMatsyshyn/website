  "texts": [
    {
      "id": "en_morning",
      "title": "Morning routine",
      "text": "I {wake} up early and make {coffee}. After breakfast I check my {calendar} and leave the house before eight.",
      "translation": "I wake up early and make coffee. After breakfast I check my calendar and leave the house before eight.",
      "translationLanguage": "English"
    },
    {
      "id": "en_shopping",
      "title": "At the shop",
      "text": "At the {shop}, I buy bread, apples, and a small bottle of {water}. The price is clear, and I pay by {card}.",
      "translation": "At the shop, I buy bread, apples, and a small bottle of water. The price is clear, and I pay by card.",
      "translationLanguage": "English"
    },
    {
      "id": "en_work_day",
      "title": "A work day",
      "text": "My work day starts with a short {meeting}. I write notes, answer {messages}, and finish one important {task}.",
      "translation": "My work day starts with a short meeting. I write notes, answer messages, and finish one important task.",
      "translationLanguage": "English"
    },
    {
      "id": "en_travel",
      "title": "Travelling",
      "text": "Tomorrow I take the {train} to another city. I need a ticket, a small {bag}, and the address of the {hotel}.",
      "translation": "Tomorrow I take the train to another city. I need a ticket, a small bag, and the address of the hotel.",
      "translationLanguage": "English"
    },
    {
      "id": "en_friend",
      "title": "Meeting a friend",
      "text": "In the evening I meet a {friend} near the station. We talk about work, family, and our plans for the {weekend}.",
      "translation": "In the evening I meet a friend near the station. We talk about work, family, and our plans for the weekend.",
      "translationLanguage": "English"
    },
    {
      "id": "en_cooking",
      "title": "Cooking dinner",
      "text": "I cook rice and vegetables in the {kitchen}. The meal is simple, warm, and ready before my family comes {home}.",
      "translation": "I cook rice and vegetables in the kitchen. The meal is simple, warm, and ready before my family comes home.",
      "translationLanguage": "English"
    },
    {
      "id": "en_weather",
      "title": "Weather",
      "text": "Today the {weather} is cold and windy. I wear a coat because heavy {rain} may come in the afternoon.",
      "translation": "Today the weather is cold and windy. I wear a coat because heavy rain may come in the afternoon.",
      "translationLanguage": "English"
    },
    {
      "id": "en_transport",
      "title": "Public transport",
      "text": "The bus is late, so I wait at the {station}. When it arrives, I find a seat near the {window}.",
      "translation": "The bus is late, so I wait at the station. When it arrives, I find a seat near the window.",
      "translationLanguage": "English"
    },
    {
      "id": "en_weekend",
      "title": "Weekend plans",
      "text": "On Saturday we want to visit a {market}, cook dinner, and watch a film at {home}. It is a quiet plan.",
      "translation": "On Saturday we want to visit a market, cook dinner, and watch a film at home. It is a quiet plan.",
      "translationLanguage": "English"
    },
    {
      "id": "en_home",
      "title": "My home",
      "text": "My apartment has a small {kitchen}, a bright bedroom, and a table beside the {window}. It feels comfortable.",
      "translation": "My apartment has a small kitchen, a bright bedroom, and a table beside the window. It feels comfortable.",
      "translationLanguage": "English"
    }
  ],
