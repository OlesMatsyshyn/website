  "texts": [
    {
      "id": "enlit_old_house",
      "title": "The old house",
      "text": "At dusk the {traveller} reached an old dwelling beyond the village. A dim {candle} burned in the window, and the door opened presently.",
      "translation": "At dusk the traveller reached an old home beyond the village. A dim candle burned in the window, and the door opened soon.",
      "translationLanguage": "English"
    },
    {
      "id": "enlit_dinner",
      "title": "A formal dinner",
      "text": "The guests spoke with solemn courtesy, yet each {countenance} showed a different thought. Nevertheless, the host maintained a gentle {smile}.",
      "translation": "The guests spoke very politely, but each face showed a different thought. Still, the host kept a gentle smile.",
      "translationLanguage": "English"
    },
    {
      "id": "enlit_letter",
      "title": "An unexpected letter",
      "text": "A letter arrived at noon and brought strange {news}. It spoke of an inheritance, a distant estate, and a promise made long {ago}.",
      "translation": "A letter arrived at noon and brought strange news. It spoke of an inheritance, a distant estate, and an old promise.",
      "translationLanguage": "English"
    },
    {
      "id": "enlit_village_walk",
      "title": "Through the village",
      "text": "She walked beneath ancient trees, past the quiet {hearths} of neighbours, and wondered whether fortune had changed her {path}.",
      "translation": "She walked under old trees, past the homes of neighbours, and wondered whether luck had changed her path.",
      "translationLanguage": "English"
    },
    {
      "id": "enlit_argument",
      "title": "Between acquaintances",
      "text": "The argument began as a small matter of {honour}. Soon pride overcame mercy, and neither acquaintance would speak the simple {truth}.",
      "translation": "The argument began as a small matter of honour. Soon pride overcame mercy, and neither person would speak the simple truth.",
      "translationLanguage": "English"
    },
    {
      "id": "enlit_storm",
      "title": "Storm at night",
      "text": "The storm grew fierce after midnight. Rain struck the threshold, shadows moved upon the wall, and a lonely {whisper} crossed the chamber.",
      "translation": "The storm became strong after midnight. Rain hit the doorway, shadows moved on the wall, and a lonely whisper crossed the room.",
      "translationLanguage": "English"
    },
    {
      "id": "enlit_abroad",
      "title": "News from abroad",
      "text": "News from abroad altered the family's hopes. The heir was alive, the estate was safe, and sorrow turned almost at once to {delight}.",
      "translation": "News from another country changed the family's hopes. The heir was alive, the property was safe, and sadness quickly became joy.",
      "translationLanguage": "English"
    },
    {
      "id": "enlit_ambition",
      "title": "Ambition",
      "text": "Ambition may lift a person beyond fear, but without virtue it becomes vain. Thus a noble endeavour can become mere {folly}.",
      "translation": "Ambition may help a person overcome fear, but without moral goodness it becomes empty. In this way a noble effort can become foolishness.",
      "translationLanguage": "English"
    }
  ],
