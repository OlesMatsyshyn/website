  "texts": [
    {
      "id": "enmed_symptoms",
      "title": "Describing symptoms",
      "text": "The patient reports a {cough}, mild fever, and unusual {fatigue}. The doctor asks when the symptoms began and whether the pain is {acute} or chronic.",
      "translation": "The patient reports a cough, mild fever, and unusual fatigue. The doctor asks when the symptoms began and whether the pain is acute or chronic.",
      "translationLanguage": "English"
    },
    {
      "id": "enmed_admission",
      "title": "Hospital admission",
      "text": "During hospital {admission}, a nurse checks blood pressure, pulse, temperature, and {breathing}. The information is recorded before the patient goes to the ward.",
      "translation": "During hospital admission, a nurse checks blood pressure, pulse, temperature, and breathing. The information is recorded before the patient goes to the ward.",
      "translationLanguage": "English"
    },
    {
      "id": "enmed_medication",
      "title": "Taking medication",
      "text": "The prescription says to take one {tablet} twice a day. The pharmacist explains the dosage and mentions possible {side} effects.",
      "translation": "The prescription says to take one tablet twice a day. The pharmacist explains the dosage and mentions possible side effects.",
      "translationLanguage": "English"
    },
    {
      "id": "enmed_lab",
      "title": "Blood test",
      "text": "A small blood {sample} is sent to the laboratory. The result is compared with the normal {range} and discussed at the next appointment.",
      "translation": "A small blood sample is sent to the laboratory. The result is compared with the normal range and discussed at the next appointment.",
      "translationLanguage": "English"
    },
    {
      "id": "enmed_appointment",
      "title": "Medical appointment",
      "text": "At the clinic, the doctor performs an {examination}, reviews the test results, and suggests a simple treatment {plan}.",
      "translation": "At the clinic, the doctor performs an examination, reviews the test results, and suggests a simple treatment plan.",
      "translationLanguage": "English"
    },
    {
      "id": "enmed_recovery",
      "title": "Recovery",
      "text": "After the procedure, recovery is slow but steady. The patient monitors the {wound}, rests, drinks water, and attends a {follow-up} visit.",
      "translation": "After the procedure, recovery is slow but steady. The patient monitors the wound, rests, drinks water, and attends a follow-up visit.",
      "translationLanguage": "English"
    },
    {
      "id": "enmed_research",
      "title": "Research experiment",
      "text": "The research team follows a clear {protocol}. Each participant gives consent, and the data are stored for later {analysis}.",
      "translation": "The research team follows a clear protocol. Each participant gives consent, and the data are stored for later analysis.",
      "translationLanguage": "English"
    },
    {
      "id": "enmed_summary",
      "title": "Clinical summary",
      "text": "The clinical summary lists the diagnosis, current medication, allergies, and main {risk} factors. It also describes the expected {outcome}.",
      "translation": "The clinical summary lists the diagnosis, current medication, allergies, and main risk factors. It also describes the expected outcome.",
      "translationLanguage": "English"
    }
  ],
