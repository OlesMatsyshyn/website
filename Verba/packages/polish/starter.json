  "texts": [
    {
      "id": "pl_rano",
      "title": "Rano",
      "text": "Rano piję {kawę} i jem chleb z serem. Potem idę do pracy i sprawdzam wiadomości.",
      "translation": "In the morning I drink coffee and eat bread with cheese. Then I go to work and check messages.",
      "translationLanguage": "English"
    },
    {
      "id": "pl_zakupy",
      "title": "Zakupy",
      "text": "W sklepie kupuję wodę, jabłka i {chleb}. Cena jest dobra, więc płacę kartą.",
      "translation": "In the shop I buy water, apples, and bread. The price is good, so I pay by card.",
      "translationLanguage": "English"
    },
    {
      "id": "pl_praca",
      "title": "Praca",
      "text": "W pracy mam krótkie spotkanie. Piszę dokument, czytam {pytania} i odpowiadam spokojnie.",
      "translation": "At work I have a short meeting. I write a document, read questions, and answer calmly.",
      "translationLanguage": "English"
    },
    {
      "id": "pl_kawiarnia",
      "title": "Kawiarnia",
      "text": "W kawiarni spotykam {przyjaciela}. Zamawiamy herbatę i rozmawiamy o weekendzie.",
      "translation": "In the café I meet a friend. We order tea and talk about the weekend.",
      "translationLanguage": "English"
    },
    {
      "id": "pl_pociag",
      "title": "Pociąg",
      "text": "Pociąg odjeżdża z dworca o ósmej. Mam {bilet} i miejsce przy oknie.",
      "translation": "The train leaves the station at eight. I have a ticket and a seat by the window.",
      "translationLanguage": "English"
    },
    {
      "id": "pl_dom",
      "title": "Dom",
      "text": "Moje mieszkanie jest małe, ale wygodne. Kuchnia jest jasna, a stół stoi przy {oknie}.",
      "translation": "My apartment is small but comfortable. The kitchen is bright, and the table stands by the window.",
      "translationLanguage": "English"
    },
    {
      "id": "pl_rodzina",
      "title": "Rodzina",
      "text": "Wieczorem odwiedzam rodzinę. Razem gotujemy kolację i mówimy o planach na {jutro}.",
      "translation": "In the evening I visit family. Together we cook dinner and talk about plans for tomorrow.",
      "translationLanguage": "English"
    },
    {
      "id": "pl_miasto",
      "title": "Miasto",
      "text": "Miasto jest duże i głośne, ale lubię spacerować po małych ulicach blisko {rynku}.",
      "translation": "The city is large and noisy, but I like walking along small streets near the market.",
      "translationLanguage": "English"
    },
    {
      "id": "pl_pogoda",
      "title": "Pogoda",
      "text": "Dzisiaj pogoda jest zimna. Pada {deszcz}, więc biorę parasol i ciepłą kurtkę.",
      "translation": "Today the weather is cold. It is raining, so I take an umbrella and a warm jacket.",
      "translationLanguage": "English"
    },
    {
      "id": "pl_weekend",
      "title": "Weekend",
      "text": "W weekend chcemy jechać do innego miasta. Jeśli będzie słońce, odwiedzimy park i {muzeum}.",
      "translation": "On the weekend we want to go to another city. If it is sunny, we will visit a park and a museum.",
      "translationLanguage": "English"
    }
  ],
