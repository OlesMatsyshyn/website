  "texts": [
    {
      "id": "nb_morgen",
      "title": "Morgen",
      "text": "Om morgenen drikker jeg {kaffe} og spiser brød med ost. Etterpå går jeg til {arbeid}.",
      "translation": "In the morning I drink coffee and eat bread with cheese. Afterwards I go to work.",
      "translationLanguage": "English"
    },
    {
      "id": "nb_byen",
      "title": "I byen",
      "text": "Jeg bor i en {by} med mange butikker, en park og en liten stasjon. Huset mitt ligger nær sentrum.",
      "translation": "I live in a city with many shops, a park, and a small station. My house is near the centre.",
      "translationLanguage": "English"
    },
    {
      "id": "nb_transport",
      "title": "Transport",
      "text": "Jeg tar {bussen} til universitetet. Billetten ligger på telefonen, og reisen tar tjue minutter.",
      "translation": "I take the bus to the university. The ticket is on the phone, and the trip takes twenty minutes.",
      "translationLanguage": "English"
    },
    {
      "id": "nb_arbeid",
      "title": "Arbeid",
      "text": "På {arbeid} skriver jeg notater, leser meldinger og svarer på viktige spørsmål.",
      "translation": "At work I write notes, read messages, and answer important questions.",
      "translationLanguage": "English"
    },
    {
      "id": "nb_butikk",
      "title": "Butikk",
      "text": "I butikken kjøper jeg vann, epler og {brød}. Prisen er grei, og køen er kort.",
      "translation": "In the shop I buy water, apples, and bread. The price is fine, and the queue is short.",
      "translationLanguage": "English"
    },
    {
      "id": "nb_kafe",
      "title": "Kafé",
      "text": "På kafeen møter jeg en {venn}. Vi bestiller te og snakker om planer for helgen.",
      "translation": "At the café I meet a friend. We order tea and talk about plans for the weekend.",
      "translationLanguage": "English"
    },
    {
      "id": "nb_hjem",
      "title": "Hjemme",
      "text": "Leiligheten min har et lite {kjøkken}, et lyst soverom og et bord ved vinduet.",
      "translation": "My apartment has a small kitchen, a bright bedroom, and a table by the window.",
      "translationLanguage": "English"
    },
    {
      "id": "nb_vaer",
      "title": "Vær",
      "text": "I dag er {været} kaldt og vindfullt. Jeg tar på meg en jakke fordi det kan komme regn.",
      "translation": "Today the weather is cold and windy. I put on a jacket because rain may come.",
      "translationLanguage": "English"
    },
    {
      "id": "nb_helg",
      "title": "Helg",
      "text": "I helgen vil vi gå til markedet, lage middag og se en film {hjemme}.",
      "translation": "At the weekend we want to go to the market, make dinner, and watch a film at home.",
      "translationLanguage": "English"
    },
    {
      "id": "nb_reise",
      "title": "Reise",
      "text": "I morgen tar jeg {toget} til en annen by. Jeg trenger billett, adresse og en liten veske.",
      "translation": "Tomorrow I take the train to another city. I need a ticket, an address, and a small bag.",
      "translationLanguage": "English"
    }
  ],
